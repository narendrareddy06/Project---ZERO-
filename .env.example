# Project ZERO Environment Configuration
# Target Operating Budget: ₹0

PROJECT_ENV=development
DATA_DIR=data
LOGS_DIR=logs
DATABASE_PATH=data/project_zero.db

# Minimum confidence required for evidence-backed decisions (0.0 - 1.0)
# Default is 0.65 to ensure claims have verifiable backing beyond assumptions.
CONFIDENCE_THRESHOLD=0.65

# External Provider Settings (Disabled by default for ₹0 budget enforcement)
# No API calls are made in Stage A.
ALLOW_PAID_APIS=false
GEMINI_API_KEY=
GROQ_API_KEY=
